{
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "BreakDurationSeconds": 30
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },

      "product-image-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/product-images/{**catch-all}"
        }
      },

      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "http://localhost:5208/"
          }
        }
      },

      "product-cluster": {
        "Destinations": {
          "product-api": {
            "Address": "http://localhost:5126/"
          }
        }
      },

      "order-cluster": {
        "Destinations": {
          "order-api": {
            "Address": "http://localhost:5092/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}